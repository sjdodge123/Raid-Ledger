# Database
DATABASE_URL=postgresql://user:password@localhost:5432/raid_ledger

# Discord OAuth (get from Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# JWT Authentication
JWT_SECRET=generate_a_strong_random_secret_here

# Frontend URL
CLIENT_URL=http://localhost:5173

# CORS Configuration
# Required in production (NODE_ENV=production)
# An explicit origin allows only that origin (dev also allows localhost:80/5173/5174);
# any other Origin gets 403. CORS_ORIGIN=auto (the all-in-one image's default) means
# SAME-ORIGIN ONLY: a request is allowed when it has no Origin, or when the Origin's
# hostname equals the request's own Host header (ports ignored). ROK-1732.
CORS_ORIGIN=http://localhost:5173

# What CORS_ORIGIN=auto does with a mismatched Origin (ignored for an explicit CORS_ORIGIN):
#   enforce (default) mismatched Origins get 403 "Origin not allowed" and the route never runs
#   report  nothing is rejected; each would-be rejection is logged as a
#           rate-limited "[cors-auto] would-reject" line (no IPs, cookies or query strings)
# Unset or blank -> enforce. Unrecognised -> report plus a startup warning (fails open).
# POST /csp-report is always allowed (browsers send CSP reports with Origin: null).
# Rollback: set CORS_AUTO_MODE=report and restart the container — no image rebuild needed.
# CORS_AUTO_MODE=enforce

# Origin guard on the cookie-bearing auth POSTs (/auth/refresh, /auth/logout). ROK-1755.
# Independent of CORS_AUTO_MODE: report mode there does NOT relax this guard.
#   enforce (default) a cross-site / mismatched-Origin refresh or logout gets 403
#   report  nothing is rejected; each would-be rejection is logged as a
#           "ROK-1755: would-reject" line
# Unset, blank or unrecognised -> enforce. Rollback for a proxy that rewrites the
# Host header: set AUTH_ORIGIN_GUARD=report and restart — no image rebuild needed.
# AUTH_ORIGIN_GUARD=enforce

# Reverse-proxy trust (production only)
# Which X-Forwarded-For hops the API trusts when it resolves a visitor's IP for
# rate limiting. Default: loopback, linklocal, uniquelocal — every private hop
# (Docker bridge, cloudflared tunnel, NAS reverse proxy) is skipped and the
# first public address is the visitor. Setting TRUST_PROXY REPLACES this
# default, it does not add to it, so keep loopback, linklocal, uniquelocal in
# the list. A proxy in front with a public address:
#   TRUST_PROXY=loopback, linklocal, uniquelocal, <proxy-ip>
# A whole number trusts that many hops, but the right count depends on the
# path into the container and one too many is spoofable — prefer the list. Anything
# else is a comma-separated list of IPs/CIDRs/names (Express syntax).
# true trusts EVERY hop, so a visitor can spoof X-Forwarded-For and dodge rate
# limits — don't use it on the internet; false trusts none. An invalid value
# stops the API at startup with "Invalid TRUST_PROXY".
# Cloudflare through a port-forward (no tunnel): the last public hop is a
# Cloudflare edge server, so append Cloudflare's ranges
# (https://www.cloudflare.com/ips/) or visitors share limits per edge.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Optional: IGDB API (for game discovery)
# Pre-seeded with 48+ games - keys only needed for additional game search
# Get credentials from Twitch Developer Console: https://dev.twitch.tv/console
# IGDB_CLIENT_ID=your_twitch_client_id
# IGDB_CLIENT_SECRET=your_twitch_client_secret

# Admin Bootstrap (deploy scripts manage this automatically)
# ADMIN_PASSWORD=         # Set to use a specific password; leave empty for random

# Optional: Node environment
# NODE_ENV=development

# Nest logger threshold (default: "log" in production, "debug" in development)
# Valid values: error | warn | log | debug | verbose
# Levels at or above the threshold are emitted; "fatal" is always included.
# LOG_LEVEL=log

# Bootstrap logger self-test (default: false)
# When true, the API emits one sentinel WARN and one sentinel ERROR line after
# app.listen() so operators can verify the warn/error channels reach the log sink.
# LOGGER_SELF_TEST=false

# Debug logging — PERF gate only (default: false)
# When true, enables [PERF] instrumentation lines (perf-logger, perf-memory-monitor,
# perf-logging.interceptor). Does NOT control Nest log levels — use LOG_LEVEL for that.
# Legacy bridge: if LOG_LEVEL is unset and DEBUG=true, Nest threshold is upgraded
# to "debug" so dev environments that only set DEBUG=true keep their current behavior.
DEBUG=false

# Error reporting to the Raid Ledger maintainers' Sentry (ROK-1838) — ON by
# default for the API and the web app. ENABLE_TELEMETRY=false opts out; local
# dev, CI and test instances should keep it off so they don't spend the quota.
# DISABLE_TELEMETRY=true also forces it off (and wins over ENABLE_TELEMETRY=true).
# Production-only on the API (NODE_ENV=production). Read at startup.
ENABLE_TELEMETRY=false
# DISABLE_TELEMETRY=true

# Voice game-binding threshold (ROK-1711). Discord bots never count toward a
# binding's minPlayers, except these bot user ids (comma-separated) and only
# when DEMO_MODE=true. Set it to the companion test bot's user id to run the
# voice smoke locally. CI derives it from TEST_BOT_TOKEN; fleet envs get it
# from RL_TEST_BOT_USER_ID on the rl-infra VM.
# VOICE_THRESHOLD_BOT_ALLOWLIST=
