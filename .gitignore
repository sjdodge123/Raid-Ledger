!scripts/rl-reencrypt-settings.mjs
!scripts/rl-settings-bundle.mjs
!scripts/test-plan-comments.sh
!scripts/recover-stuck-migration.sh
# Launcher .mcp.json uses for the three repo MCP servers (falls back to the main checkout's install).
!scripts/mcp-launch.sh
# ROK-1160: the weekly backup restore drill (harness + assertion tiers).
!scripts/backup-restore-drill.sh
!scripts/restore-drill-assertions.mjs
!scripts/restore-drill-assertions.spec.mjs
!scripts/restore-drill-corruption.spec.mjs
!scripts/restore-drill-journal.mjs
!scripts/restore-drill-journal.spec.mjs
!scripts/validate-ci-discord-env.spec.mjs
!scripts/validate-ci-smoke-ci-parity.spec.mjs
# ROK-1566: the diff-keyed push sentinel (surface hash + push gate specs).
!scripts/surface-hash.spec.mjs
!scripts/push-gate.spec.mjs
# ROK-1565: the scoped-Playwright / E2E_SCOPE gate spec. `scripts/*` ignores the
# whole directory, so a new script or spec here is INVISIBLE to `git add -A`
# until it is un-ignored — this one shipped untracked for four commits.
!scripts/validate-ci-e2e-scope.spec.mjs
!scripts/restore-drill.constants.mjs
!scripts/test/
# ROK-1286: keep the Playwright auth-cache DIRECTORY in the synced tree (so the
# fleet Mutagen replica never deletes it mid-run) while still ignoring the JWT
# token files written into it at runtime.
!scripts/.auth/
scripts/.auth/*
!scripts/.auth/.gitkeep
!/api/scripts/
implementation_plan.md
walkthrough.md
handover.zip

