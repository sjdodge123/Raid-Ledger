{
  "name": "@raid-ledger/relay-hub",
  "version": "0.0.1",
  "description": "Raid Ledger relay hub: headless NestJS service (ROK-1669)",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
