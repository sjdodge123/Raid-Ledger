{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    // TypeScript 6 defaults `types` to []: name the ambient packages.
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    // ROK-1161 flags, on for every relay-hub file (app code and specs).
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  // Specs are included so `tsc --noEmit -p relay-hub/tsconfig.json` typechecks
  // them: ts-jest does not.
  "include": ["src/**/*.ts"]
}
