---
import { LINKS, withBase } from '../data/site';

/** In-page anchors point at the landing page, so they also work from /guides/*. */
const home = (hash: string): string => withBase('') + hash;
import GitHubIcon from './GitHubIcon.astro';

const links = [
  [home('#how'), 'How it works'],
  [home('#features'), 'Features'],
  [home('#games'), 'Games'],
  [home('#self-host'), 'Self-host'],
  [home('#faq'), 'FAQ'],
] as const;
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href={home('#top')} aria-label="Raid Ledger home"
      ><span class="brand-mark" aria-hidden="true">RL</span><span class="brand-text">Raid Ledger</span></a
    >
    <nav class="nav-links" aria-label="Primary">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-ghost nav-gh" href={LINKS.repo}><GitHubIcon /> GitHub</a>
      <a class="btn btn-primary" href={home('#self-host')}>Get started</a>
      <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href={LINKS.repo}>GitHub</a>
  </div>
</header>
