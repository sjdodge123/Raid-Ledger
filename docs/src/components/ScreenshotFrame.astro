---
// A browser/phone frame for screenshot slot S1–S12. Shows the real capture
// when src/assets/screenshots/<id>-<slug>.png exists, an interim June
// screenshot when the slot maps one (src/data/shots.ts), else a placeholder.
import { Image } from 'astro:assets';
import { resolveShot, type ShotId } from '../data/shots';

interface Props {
  id: ShotId;
  /** Eager-load (hero only). */
  priority?: boolean;
}

const { id, priority = false } = Astro.props;
const shot = resolveShot(id);
const loading = priority ? 'eager' : 'lazy';
const widths = shot.phone ? [200, 400] : [640, 960, 1440];
const sizes = shot.phone ? '200px' : '(min-width: 1024px) 600px, 100vw';
const alt = `${shot.title}. ${shot.desc}.`;
---
<div class:list={['shot', { phone: shot.phone }]} data-shot={id}>
  {!shot.phone && (
    <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i><span>{shot.bar}</span></div>
  )}
  {shot.src ? (
    <>
      <Image
        src={shot.src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        class:list={['shot-img', { 'has-light': shot.light }]}
        data-interim={shot.interim ? 'true' : undefined}
      />
      {shot.light && (
        <Image src={shot.light} alt={alt} widths={widths} sizes={sizes} loading={loading} class="shot-img is-light" />
      )}
    </>
  ) : (
    <div class="shot-body" style={shot.aspect ? `aspect-ratio:${shot.aspect}` : undefined}>
      <div>
        <span class="shot-id">{id}</span>
        <span class="shot-title">{shot.title}</span>
        <span class="shot-desc">{shot.desc}</span>
      </div>
    </div>
  )}
</div>
