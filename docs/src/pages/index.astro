---
// Raid Ledger marketing site (ROK-2051) — the approved mockup, one section per component.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhoItsFor from '../components/WhoItsFor.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import GamePlugins from '../components/GamePlugins.astro';
import ExampleWeek from '../components/ExampleWeek.astro';
import SelfHost from '../components/SelfHost.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="top">
    <Hero />
    <WhoItsFor />
    <HowItWorks />
    <Features />
    <GamePlugins />
    <ExampleWeek />
    <SelfHost />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
