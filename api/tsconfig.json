{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    // ROK-1161 tracked override — phase 8 flips this to true and deletes the
    // tsconfig.build.json override. OFF here only because this config also
    // typechecks specs + test infra (CI "Typecheck (full project, incl. tests)",
    // validate-ci run_typecheck, ESLint projectService). Measured at f82d72ae4:
    // 5,912 errors — 5,876 in 527 *.spec.ts files + 36 in 11 spec-helpers /
    // src/common/testing files. Shipped code is gated ON via tsconfig.build.json.
    "noUncheckedIndexedAccess": false
  },
  "ts-node": {
    "files": true
  }
}
