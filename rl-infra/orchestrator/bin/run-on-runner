#!/usr/bin/env bash
# Execute a command inside the calling agent's runner container.
# Streams stdout/stderr back to the caller. Exits with the command's exit code.
#
# Required env: RL_AGENT_ID
# Usage: run-on-runner -- <command> [args...]
set -euo pipefail
source "$(dirname "$0")/_state.sh"
# A3-B — re-assert /workspace exec bits immediately before dispatch. The
# flush-time repair in cli/rl does not survive a sync that lands after it.
source "$(dirname "$0")/_exec_bits.sh"

if [[ "${1:-}" != "--" ]]; then
    echo "usage: run-on-runner -- <cmd> [args...]" >&2
    exit 2
fi
shift

if [[ -z "${RL_AGENT_ID:-}" ]]; then echo "RL_AGENT_ID required" >&2; exit 2; fi
SLOT=$(state::slot_for_agent "$RL_AGENT_ID")
[[ -z "$SLOT" ]] && { echo "no slot — run claim first" >&2; exit 2; }

CONTAINER="rl-runner-${SLOT}"
# -i (not -t) so stdin pipes work without a TTY; callers can opt in via RL_TTY=1.
EXEC_FLAGS="-i"
[[ "${RL_TTY:-0}" == "1" ]] && EXEC_FLAGS="-it"

# A3 fix 2 — forward the per-task cancellation marker (see task-cancel's runner
# sweep). Env is inherited by every descendant inside the container, so a cancel
# can find the whole tree by task id. Omitted when unset.
TASK_MARKER_FLAGS=()
if [[ -n "${RL_TASK_ID:-}" ]]; then
    TASK_MARKER_FLAGS=(-e "RL_TASK_ID=$RL_TASK_ID")
fi

audit::log run-on-runner start "$(jq -nc --argjson slot "$SLOT" --arg cmd "$*" '{slot:$slot, cmd:$cmd}')"

# A3-B — repair BEFORE dispatch, not after sync. Fatal on failure: running the
# command anyway produces a bare 126 with no assertion output, which is exactly
# the failure mode this exists to remove.
EXEC_BITS_RC=0
exec_bits::ensure_before_dispatch "$CONTAINER" || EXEC_BITS_RC=$?
if (( EXEC_BITS_RC != 0 )); then
    audit::log run-on-runner exec_bits_failed \
        "$(jq -nc --argjson slot "$SLOT" --argjson rc "$EXEC_BITS_RC" '{slot:$slot, rc:$rc}')"
    exit "$EXEC_BITS_RC"
fi

set +e
docker exec $EXEC_FLAGS \
    -w /workspace \
    -e RL_SLOT="$SLOT" \
    -e RL_TARGET=runner \
    ${TASK_MARKER_FLAGS[@]+"${TASK_MARKER_FLAGS[@]}"} \
    "$CONTAINER" \
    "$@"
RC=$?
set -e
audit::log run-on-runner end "$(jq -nc --argjson slot "$SLOT" --argjson rc "$RC" '{slot:$slot, rc:$rc}')"
exit "$RC"
