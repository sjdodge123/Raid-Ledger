#!/usr/bin/env bash
# ROK-1469 D1/D6 — env-settings-overlay --slug <slug> [--slot <n>] [--sync-wins]
#
# UPSERTs the SLOT-owned settings into a running env's app_settings:
#   D1  the slot's Discord identity (bot token + OAuth client id/secret) from
#       /srv/rl-infra/.env's RL_SLOT_<N>_DISCORD_* values;
#   D6  the shared API keys (ITAD / Co-Optimus / Blizzard / LLM) from the
#       VM-side encrypted bundle, so a deploy no longer needs the operator's
#       laptop DB to be reachable.
#
# Runs AFTER sync_settings (which copies the laptop's app_settings wholesale
# and would otherwise stamp every env with the SAME bot identity) and before
# the settings-restart, so the env boots on its own bot.
#
# --sync-wins (operator ruling 2026-09-27): rl_env_deploy passes it after the
# laptop's app_settings landed (a SUCCESSFUL sync_settings or clone_prod). The
# container script then UPSERTs only the slot identity + demo_mode and INSERTs
# every other bundle key only where the env has no row (ON CONFLICT DO
# NOTHING): a synced value is kept (`kept_synced`), a key the laptop DB lacked
# is still filled (`inserted_if_absent`). Without the flag every key is
# UPSERTed (the laptop-less path). The bundle is read either way, so
# bundle_warning keeps surfacing.
#
# Secrets travel over STDIN into the container — never as argv (visible in
# `ps`), never in stdout, never in the audit log. Output is a single JSON line
# carrying key NAMES + the PUBLIC client id.
#
# Exit codes: 0 ok (including the configured-nothing no-op), 1 overlay failed,
# 2 bad args.
set -uo pipefail
BIN_DIR_SELF="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$BIN_DIR_SELF/_state.sh"
# shellcheck disable=SC1091
source "$BIN_DIR_SELF/_bot_identity.sh"
# shellcheck disable=SC1091
source "$BIN_DIR_SELF/_settings_bundle.sh"

SLUG=""
SLOT=""
SYNC_WINS=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --slug) SLUG="$2"; shift 2 ;;
        --slot) SLOT="$2"; shift 2 ;;
        --sync-wins) SYNC_WINS="--sync-wins"; shift ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

[[ -z "$SLUG" ]] && { echo "--slug required" >&2; exit 2; }
[[ "$SLUG" =~ ^[a-z0-9-]+$ ]] || { echo "slug must be [a-z0-9-]+" >&2; exit 2; }

if [[ -z "$SLOT" ]]; then
    SLOT=$(bot_identity::slot_for_slug "$SLUG")
fi
if [[ ! "$SLOT" =~ ^[0-9]+$ ]]; then
    jq -nc --arg slug "$SLUG" \
        '{ok:false, error:"slot_unresolved", slug:$slug,
          hint:"Could not resolve a slot for this slug from the env registry or the container label. Pass --slot <n> explicitly."}'
    exit 1
fi

IDENTITY_JSON=$(bot_identity::public_json "$SLOT")
IDENTITY_PAYLOAD=$(bot_identity::payload "$SLOT")
# D6: shared community API keys from the VM-side encrypted bundle. The slot
# identity is merged LAST so it wins any key collision — a bundle pushed from
# a laptop whose local DB still holds the operator's bot token must never
# overwrite the slot's own identity.
# B1: read the bundle into a FILE, not $( ). Command substitution forks a
# subshell, so SETTINGS_BUNDLE_WARNING set inside it never reaches this shell
# and a missing/undecryptable bundle shipped silently with bundle_warning:null.
BUNDLE_FILE=$(mktemp -t rl-settings-bundle.XXXXXX)
settings_bundle::payload > "$BUNDLE_FILE"
BUNDLE_PAYLOAD=$(cat "$BUNDLE_FILE")
rm -f "$BUNDLE_FILE"
BUNDLE_WARNING="${SETTINGS_BUNDLE_WARNING:-}"
# ROK-1494/1506 (2026-09-09): demo_mode is a TWO-key flag — every demo-gated
# controller checks BOTH `process.env.DEMO_MODE === 'true'` AND the
# `demo_mode` app_settings row. env-spin has always passed the env var
# (`-e DEMO_MODE=true` at the docker run), but nothing ever wrote the SETTING,
# because `setDemoMode(true)` is only reached as a side effect of seeding demo
# data or a reset — neither of which a fleet spin performs.
#
# The two halves therefore disagreed on every fleet env: `/api/system/status`
# reported demoMode:false and every `/admin/test/*` route 403'd. That silently
# broke Playwright's reset-to-seed (it DEGRADES to whatever state the env holds
# rather than failing, so a smoke run's baseline is unattributable) and blocked
# ROK-1506's fixture plan outright. It was on the operator-blocked list for days
# as "fleet envs are not in DEMO_MODE", read as an infra gap; it was an unset
# admin toggle.
#
# Seeded here rather than by calling POST /admin/settings/demo/install, because
# that route calls clearDemoData() when demo data already exists — destroying
# whatever the env was spun to hold. This writes ONLY the flag.
DEMO_PAYLOAD='{"demo_mode":"true"}'
PAYLOAD=$(jq -nc --argjson bundle "$BUNDLE_PAYLOAD" --argjson identity "$IDENTITY_PAYLOAD" \
    --argjson demo "$DEMO_PAYLOAD" \
    '$bundle + $identity + $demo')
PAYLOAD_KEYS=$(jq -nc --argjson p "$PAYLOAD" '$p | keys')

if [[ "$(jq -r 'length' <<<"$PAYLOAD_KEYS")" == "0" ]]; then
    # Nothing configured for this slot and no bundle on disk. A no-op, NOT a
    # failure — the env keeps whatever sync_settings gave it.
    #
    # NOTE since demo_mode joined the payload above this branch is effectively
    # unreachable (the map always carries at least that one key). Kept rather
    # than deleted: it is the correct behaviour if the demo seed is ever made
    # conditional, and deleting it would hide that this path ever existed.
    audit::log env-settings-overlay skipped \
        "$(jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" '{slug:$slug, slot:$slot}')" 2>/dev/null || true
    jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" --argjson identity "$IDENTITY_JSON" \
        --arg bundle_warning "$BUNDLE_WARNING" \
        '{ok:true, slug:$slug, slot:$slot, applied:[], skipped:"no_overlay_configured",
          bot_identity:$identity,
          bundle_warning: (if $bundle_warning == "" then null else $bundle_warning end)}'
    exit 0
fi

EXEC_APP="${RL_ENV_EXEC_APP:-$BIN_DIR_SELF/env-exec-app}"
OVERLAY_SCRIPT="${RL_OVERLAY_SCRIPT_PATH:-/app/dist/scripts/apply-settings-overlay.js}"
EXEC_OUT_FILE=$(mktemp -t rl-settings-overlay.XXXXXX)
EXEC_RC=0
printf '%s' "$PAYLOAD" | "$EXEC_APP" "$SLUG" -- node "$OVERLAY_SCRIPT" \
    ${SYNC_WINS:+"$SYNC_WINS"} > "$EXEC_OUT_FILE" 2>&1 || EXEC_RC=$?
# tr -d '\000' guards against a binary blob wedging jq; tail caps a runaway
# stack trace so the failure stays readable in the agent transcript.
EXEC_OUT=$(tr -d '\000' < "$EXEC_OUT_FILE" | tail -c 2048)
rm -f "$EXEC_OUT_FILE"

if (( EXEC_RC != 0 )); then
    audit::log env-settings-overlay err \
        "$(jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" --argjson rc "$EXEC_RC" '{slug:$slug, slot:$slot, rc:$rc}')" 2>/dev/null || true
    jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" --argjson rc "$EXEC_RC" \
        --arg detail "$EXEC_OUT" --argjson identity "$IDENTITY_JSON" \
        '{ok:false, error:"settings_overlay_failed", slug:$slug, slot:$slot,
          exit_code:$rc, detail:$detail, bot_identity:$identity,
          hint:"apply-settings-overlay.js failed inside rl-env-<slug>-allinone. Common causes: the image predates ROK-1469 (script missing at /app/dist/scripts/), the container is not running, or DATABASE_URL is unset in it. Rebuild the image from a branch containing api/scripts/apply-settings-overlay.ts."}'
    exit 1
fi

# The container reports the key NAMES it wrote; fall back to the keys we sent
# if an older script version printed nothing parseable.
APPLIED=$(jq -c '.applied // empty' <<<"$EXEC_OUT" 2>/dev/null || true)
[[ -z "$APPLIED" ]] && APPLIED="$PAYLOAD_KEYS"
# A sync-wins run's bundle keys: filled where absent / kept as synced (NAMES
# only). And whether the container honoured the flag at all — an image that
# predates it ignores argv and UPSERTs everything, which the caller must see.
INSERTED=$(jq -c '.inserted_if_absent // empty' <<<"$EXEC_OUT" 2>/dev/null || true)
[[ -z "$INSERTED" ]] && INSERTED='[]'
KEPT=$(jq -c '.kept_synced // empty' <<<"$EXEC_OUT" 2>/dev/null || true)
[[ -z "$KEPT" ]] && KEPT='[]'
HONOURED=$(jq -c '.sync_wins // empty' <<<"$EXEC_OUT" 2>/dev/null || true)
[[ "$HONOURED" == "true" ]] || HONOURED=false

audit::log env-settings-overlay ok \
    "$(jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" --argjson applied "$APPLIED" '{slug:$slug, slot:$slot, applied:$applied}')" 2>/dev/null || true
jq -nc --arg slug "$SLUG" --argjson slot "$SLOT" --argjson applied "$APPLIED" \
    --argjson identity "$IDENTITY_JSON" --arg bundle_warning "$BUNDLE_WARNING" \
    --argjson inserted "$INSERTED" --argjson kept "$KEPT" --argjson honoured "$HONOURED" \
    '{ok:true, slug:$slug, slot:$slot, applied:$applied, bot_identity:$identity,
      inserted_if_absent:$inserted, inserted_count:($inserted | length),
      kept_synced:$kept, kept_count:($kept | length), sync_wins:$honoured,
      bundle_warning: (if $bundle_warning == "" then null else $bundle_warning end)}'
