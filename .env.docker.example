# ===========================================
# Raid-Ledger Docker Environment Configuration
# ===========================================
# Copy this file to .env.docker and fill in the required values
# then run: docker compose -f docker-compose.prod.yml up -d

# ===================
# Database (Required)
# ===================
POSTGRES_USER=raid_ledger
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=raid_ledger

# ===================
# Authentication (Required)
# ===================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# ===================
# Server Configuration
# ===================
# Port to expose the application (default: 80)
PORT=80

# CORS origin for API requests
CORS_ORIGIN=http://localhost

# ===================
# Discord OAuth (Optional)
# ===================
# Get these from Discord Developer Portal
# Leave empty to use local admin authentication
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost/api/auth/discord/callback

# ===================
# IGDB API (Optional)
# ===================
# Get these from Twitch Developer Portal for game discovery
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Error reporting to the Raid Ledger maintainers' Sentry (ROK-1838) — ON by
# default: the API and the web app send error reports so the maintainers can
# fix what breaks. Set ENABLE_TELEMETRY=false to opt out (nothing is sent).
# DISABLE_TELEMETRY=true also forces it off (and wins over ENABLE_TELEMETRY=true).
# Production-only on the API (NODE_ENV=production). Read at startup.
# ENABLE_TELEMETRY=false
# DISABLE_TELEMETRY=true
